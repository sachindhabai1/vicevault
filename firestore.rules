rules_version = '2';

// ===============================================================
// VICEVAULT // Cloud Firestore Security Rules
// ===============================================================
// Real-time synchronization for e-commerce store, client auth,
// order placement, address updates, and admin dashboard.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // USERS COLLECTION (Registered Users & Profiles)
    // -------------------------------------------------------------
    match /users/{userId} {
      // Allow read for user profile and admin dashboard customer directory
      allow read: if true;

      // Allow users to create and update their profiles (e.g. signup, delivery address)
      allow create, update: if true;

      // Deletion prevented from client
      allow delete: if false;
    }

    // -------------------------------------------------------------
    // ORDERS COLLECTION
    // -------------------------------------------------------------
    match /orders/{orderId} {
      // Allow customers to place orders and admin dashboard to read/manage orders
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // AUTHENTICATION & RATE LIMITING (Server/Admin SDK Only)
    // -------------------------------------------------------------
    match /otp/{email} {
      allow read, write: if false;
    }

    match /loginAttempts/{email} {
      allow read, write: if false;
    }

    match /otpRateLimits/{email} {
      allow read, write: if false;
    }

    match /verifiedEmails/{email} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // DEFAULT DENY RULE
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
