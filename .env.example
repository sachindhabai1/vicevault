# ==============================================================
# VICEVAULT // Firebase Client Web App Configuration Template
# ==============================================================
# Copy these values into your environment or directly into firebase-config.js.
#
# IMPORTANT SECURITY NOTES:
# 1. These are Web SDK client credentials (safe to be in frontend).
# 2. NEVER put Firebase Admin SDK private service-account keys or database secrets in frontend code.
# 3. Secure your backend via Firebase Console > Authentication settings and Cloud Firestore Security Rules (firestore.rules).
#
# Obtain these credentials from:
# Firebase Console (https://console.firebase.google.com/) 
# -> Project Settings (Gear icon) -> General -> Your apps -> Web app (</>)

VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="vicevault-store.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="vicevault-store"
VITE_FIREBASE_STORAGE_BUCKET="vicevault-store.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# (Optional: If using Firebase Measurement/Analytics)
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
