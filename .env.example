# ==============================================================
# VICEVAULT // Backend & Firebase Admin Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your real credentials:
# cp .env.example .env

PORT=5001
NODE_ENV=development

# Web App Firebase API Key (used by backend for accounts:signInWithPassword REST API)
FIREBASE_API_KEY=AIzaSyA0bGA0W28MGU_tv23uVrOjP9vuxrIvhVI
FIREBASE_PROJECT_ID=webcode-5ecca

# Path to the Firebase Admin SDK Service Account JSON file (keep in project root and git-ignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# HMAC-SHA256 Secret Key for hashing OTPs (Must be long, random, and kept secret)
OTP_SECRET=change_this_to_a_random_32_byte_secret_key_in_production

# Nodemailer Gmail SMTP Configuration (App Password required)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. "ViceVault Store") and copy the 16-character password
GMAIL_USER=your_verified_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Allowed CORS origins (comma-separated list of frontends)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,https://sachindhabai1.github.io
